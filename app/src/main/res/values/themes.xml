<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="base_escura">#0B0B10</color>

    <!-- Esquema único: texto claro sobre fundo escuro (DESIGN.md §3). -->
    <style name="Tema.Pomodoro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/base_escura</item>
        <item name="android:windowSplashScreenBackground">@color/base_escura</item>
    </style>

    <!--
        Splash do sistema (core-splashscreen): só a cor de fundo da splash animada, sem ícone.
        O ícone transparente evita um segundo blob piscando antes do animado (ticket 13).
    -->
    <style name="Tema.Pomodoro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/base_escura</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Tema.Pomodoro</item>
    </style>
</resources>
